{
  "about": "MG-Proof header values (one line each, without the header name) and their result; the same cases with every other reason are in kat.json mg_proof",
  "cases": [
    {
      "file": "valid.txt",
      "request": {
        "method": "POST",
        "scheme": "https",
        "host": "example.com",
        "path": "/api/save",
        "now_s": 1790000000,
        "expected_jkt": "L4dd7awNurWUQc4fTCqCUVBTgWLzOpDFXjyWVZ9LxOc"
      },
      "expect": "valid"
    },
    {
      "file": "valid-high-s.txt",
      "request": {
        "method": "POST",
        "scheme": "https",
        "host": "example.com",
        "path": "/api/save",
