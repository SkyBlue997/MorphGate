      {
        "id": "a2",
        "version": "1",
        "ref": "mg_upstream_key_v1",
        "description": "MorphGate: static x-mg-upstream-key for the Edge's upstream key check. The value is a secret: set it in the dashboard or API only, rotate with mgctl keys gen-upstream --rotate (the Edge accepts the current and the previous value).",
        "expression": "true",
        "action": "rewrite",
        "action_parameters": {
          "headers": {
            "x-mg-upstream-key": {
              "operation": "set",
              "value": "REPLACE-ME with values[0] from mgctl keys gen-upstream"
            }
          }
        },
        "enabled": true,
        "last_updated": "2026-09-20T08:00:00.000000Z"
      }
    ]
