{
  "name": "@ermiaodada/morphgate-web-sdk",
  "version": "0.1.0-phase1",
  "description": "First-party browser assets for MorphGate Phase 1: an owner-operated defensive bot-management platform.",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=iife --minify --target=es2020 --legal-comments=none --outfile=dist/mg.js && node scripts/build-dist.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "size": "node scripts/size-check.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run size && pnpm run pack:check",
    "pack:check": "node scripts/check-package.mjs",
    "prepack": "npm run check"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SkyBlue997/MorphGate.git",
    "directory": "sdk/web"
  },
  "homepage": "https://github.com/SkyBlue997/MorphGate/tree/master/sdk/web#readme",
  "bugs": {
    "url": "https://github.com/SkyBlue997/MorphGate/issues"
  },
  "files": [
    "dist/sdk/",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "preview",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "morphgate",
    "bot-management",
    "traffic-security",
    "browser-sdk",
    "proof-of-work"
  ]
}
