# Copy to deploy/compose/.env (git-ignored) and replace every placeholder.
# All services publish on 127.0.0.1 only, but treat these as real credentials.

# Optional profiles to start with `make dev-up`: grafana, tunnel, lab (comma-separated).
COMPOSE_PROFILES=

VALKEY_PASSWORD=<valkey-password>

POSTGRES_USER=morphgate
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_DB=morphgate

# Retention: VictoriaMetrics (default 31d), VictoriaLogs vl-main (30d) and vl-short (7d).
VM_RETENTION=31d
VL_MAIN_RETENTION=30d
VL_SHORT_RETENTION=7d

# Profile "grafana" only.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<grafana-admin-password>

# Profile "tunnel" only: token of a remotely-managed Cloudflare Tunnel for one of
# your own zones. Never commit a real token.
TUNNEL_TOKEN=<cloudflare-tunnel-token>
